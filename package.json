{
  "name": "@borgels/mcp-server-saxo",
  "version": "0.2.2",
  "description": "MCP server for the Saxo Bank OpenAPI (SIM and LIVE trading).",
  "type": "module",
  "main": "./dist/transports/stdio.js",
  "exports": {
    ".": "./dist/transports/stdio.js",
    "./gateway": {
      "types": "./dist/gateway.d.ts",
      "default": "./dist/gateway.js"
    }
  },
  "files": [
    "dist",
    "manifest.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    ".env.example",
    "policy.example.json"
  ],
  "bin": {
    "mcp-server-saxo": "./dist/transports/stdio.js"
  },
  "scripts": {
    "build": "tsup src/transports/stdio.ts src/transports/http.ts src/bin/auth.ts src/gateway.ts --format esm --dts --clean --sourcemap",
    "dev": "tsx src/transports/stdio.ts",
    "dev:http": "tsx src/transports/http.ts",
    "auth": "tsx src/bin/auth.ts",
    "probe:marketoverview": "tsx src/bin/probe-marketoverview.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build",
    "prepack": "npm run typecheck && npm test && npm run build",
    "smoke:live": "tsx test/live-smoke.ts",
    "mcpb:validate": "npx -y -p @anthropic-ai/mcpb@^2.1.2 mcpb validate manifest.json",
    "mcpb:pack": "npx -y -p @anthropic-ai/mcpb@^2.1.2 mcpb pack . mcp-server-saxo.mcpb"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borgels/mcp-server-saxo.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "saxo",
    "saxobank",
    "trading",
    "openapi",
    "borgels"
  ],
  "author": "Borgels",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.11"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bugs": {
    "url": "https://github.com/borgels/mcp-server-saxo/issues"
  },
  "homepage": "https://github.com/borgels/mcp-server-saxo#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "ip-address": ">=10.1.1",
    "hono": ">=4.12.21",
    "fast-uri": ">=4.1.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
